rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tylko zalogowani użytkownicy. Odtwarzanie wideo działa przez tokenizowane
    // getDownloadURL (pobranie pliku przez token omija reguły), więc read: auth nie psuje playbacku.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
} 